# MySQL 8.0.16+ required for enforced CHECK constraints. Run scripts/setup_mysql.py
# to provision an isolated local MySQL instance without administrator rights.
DATABASE_URL=mysql+pymysql://gridmind:CHANGE_ME@127.0.0.1:3307/gridmind
# Use sqlite+pysqlite:///./data/gridmind.db only for explicit portable development.
EVENT_BACKEND=local
EVENT_DIRECTORY=data/events
MODEL_DIRECTORY=data/models
RAW_DIRECTORY=data/raw
API_KEY=
# AWS deferred. No credential is required for the local event journal.
AWS_REGION=ap-south-1
DYNAMODB_TABLE=GridMindSimulationEvents
# DYNAMODB_ENDPOINT_URL=
# Configure credentials via your standard AWS profile, never in source files.
# AWS_PROFILE=gridmind
# Existing non-private databases: supply an administrator URL temporarily through
# GRIDMIND_MIGRATION_URL for scripts/migrate.py; do not put it in shell arguments.
# Optional measured-energy feed: JSON observations array; see docs/API.md.
LIVE_CONTEXT_URL=
LIVE_CONTEXT_TOKEN=
LIVE_CONTEXT_REGION=Custom
LIVE_CONTEXT_TIMEZONE=UTC
