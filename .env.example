# Copy this file to .env when using a separately managed MySQL database.
# The local setup script can provision a private MySQL 8+ instance on port 3307.
# Replace CHANGE_ME with the password for a dedicated, least-privilege SQL user.
DATABASE_URL=mysql+pymysql://gridmind:CHANGE_ME@127.0.0.1:3307/gridmind

# Relational source of truth is MySQL. SQLite is supported for isolated development.
# Example SQLite URL: sqlite+pysqlite:///./data/gridmind.db

# Local journal is the default; no AWS credentials are needed.
EVENT_BACKEND=local
EVENT_DIRECTORY=data/events
MODEL_DIRECTORY=data/models
RAW_DIRECTORY=data/raw
# Optional X-API-Key for API data endpoints. Leave blank for local loopback use.
API_KEY=

# AWS/DynamoDB are deferred. Configure these only when connecting the event adapter.
AWS_REGION=ap-south-1
DYNAMODB_TABLE=GridMindSimulationEvents
# Optional custom DynamoDB-compatible endpoint; normally leave unset.
DYNAMODB_ENDPOINT_URL=
# Configure AWS credentials through the standard AWS SDK profile/credential chain.
# Never put AWS access keys in this file.

# Existing non-private databases: supply an administrator URL temporarily through
# GRIDMIND_MIGRATION_URL for scripts/migrate.py. Do not commit this value.

# Optional measured-energy JSON provider. Leave blank to use historical replay.
LIVE_CONTEXT_URL=
LIVE_CONTEXT_TOKEN=
LIVE_CONTEXT_NAME=Configured measured-energy feed
LIVE_CONTEXT_REGION=Custom
LIVE_CONTEXT_TIMEZONE=UTC
